# Copy to secrets.yaml in the same folder as rflink-bridge.yaml. Never commit the real file.
#
# Generate the API key in PowerShell 7:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# or, if you have OpenSSL:
#   openssl rand -base64 32

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

api_encryption_key: "base64-32-bytes-goes-here"
ota_password: "choose-something-long"
